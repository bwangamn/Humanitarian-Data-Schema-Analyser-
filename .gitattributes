# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files that should always use LF in the repo
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.rst text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.csv text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
.gitignore text eol=lf

# Binary files — Git should never modify these
*.xlsx binary
*.xls binary
*.whl binary
*.tar.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
