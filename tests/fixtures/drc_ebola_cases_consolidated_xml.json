{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Humanitarian Dataset Schema (XML)",
    "type": "object",
    "properties": {
        "@id": {
            "type": "string",
            "examples": [
                "ER-000001",
                "ER-000002",
                "ER-000003"
            ]
        },
        "country_iso3": {
            "type": "string",
            "examples": [
                "COD"
            ]
        },
        "admin_level": {
            "type": "string",
            "examples": [
                "health_zone",
                "national"
            ]
        },
        "location": {
            "type": "object",
            "properties": {
                "location_name": {
                    "type": "string"
                },
                "name_as_reported": {
                    "type": "string"
                },
                "location_code": {
                    "type": "object",
                    "properties": {
                        "@type": {
                            "type": "string"
                        },
                        "#text": {
                            "type": "string"
                        }
                    }
                },
                "province": {
                    "type": "string"
                },
                "population_estimate": {
                    "type": "string"
                }
            },
            "examples": [
                {
                    "location_name": "Mongbalu",
                    "name_as_reported": "Mongbwalu",
                    "location_code": {
                        "@type": "pcode",
                        "#text": "CD540510"
                    },
                    "province": "Ituri",
                    "population_estimate": "78500"
                },
                {
                    "location_name": "R\u00e9publique d\u00e9mocratique du Congo",
                    "name_as_reported": "DRC",
                    "location_code": {
                        "@type": "iso3",
                        "#text": "COD"
                    },
                    "province": "National",
                    "population_estimate": "181500"
                },
                {
                    "location_name": "Bunia",
                    "name_as_reported": "Bunia",
                    "location_code": {
                        "@type": "pcode",
                        "#text": "CD540202"
                    },
                    "province": "Ituri",
                    "population_estimate": "275000"
                }
            ]
        },
        "report_date": {
            "type": "string",
            "format": "date",
            "examples": [
                "14/05/2026",
                "15/05/2026",
                "17/05/2026"
            ]
        },
        "indicator": {
            "type": "string",
            "examples": [
                "case",
                "contact_traced",
                "death"
            ]
        },
        "case_classification": {
            "type": [
                "string",
                "null"
            ],
            "examples": [
                "confirmed",
                "suspected"
            ]
        },
        "time_period": {
            "type": "string",
            "examples": [
                "cumulative"
            ]
        },
        "case_count": {
            "type": "string",
            "x-numeric-string": true,
            "x-potential-type": "integer",
            "examples": [
                "0",
                "82",
                "57"
            ]
        },
        "unit": {
            "type": "string",
            "examples": [
                "count"
            ]
        },
        "alert_level": {
            "type": "string",
            "examples": [
                "low",
                "high",
                "medium"
            ]
        },
        "data_provider": {
            "type": "string",
            "examples": [
                "INRB-UMIE",
                "SitRep MVEBDB N\u00b0083, 06/08/2026",
                "SitRep MVEBDB N\u00b0085, 07/08/2026"
            ]
        },
        "source_link": {
            "type": [
                "string",
                "null"
            ],
            "examples": [
                "https://raw.githubusercontent.com/INRB-UMIE/BDBV2026-Data/main/data/insp_sitrep/processed/insp_sitrep__cumulative_confirmed_cases__daily.csv",
                "https://raw.githubusercontent.com/INRB-UMIE/BDBV2026-Data/main/data/insp_sitrep/processed/insp_sitrep__cumulative_contacts_traced__daily.csv",
                "https://raw.githubusercontent.com/INRB-UMIE/BDBV2026-Data/main/data/insp_sitrep/processed/insp_sitrep__cumulative_suspected_deaths__daily.csv"
            ]
        },
        "quality_check": {
            "type": [
                "string",
                "null"
            ],
            "examples": [
                "manually transcribed"
            ]
        },
        "comment": {
            "type": [
                "string",
                "null"
            ],
            "examples": [
                "Missing from INRB-UMIE's national_cumulative_confirmed_cases file (no 2026-08-06 row); transcribed from government SitRep PDF.",
                "Missing from INRB-UMIE's national_cumulative_confirmed_deaths file (no 2026-08-06 row); transcribed from government SitRep PDF.",
                "Missing from INRB-UMIE's national_cumulative_confirmed_cases file (no 2026-08-07 row); transcribed from government SitRep PDF."
            ]
        }
    },
    "required": [
        "@id",
        "country_iso3",
        "admin_level",
        "location",
        "report_date",
        "indicator",
        "time_period",
        "case_count",
        "unit",
        "alert_level",
        "data_provider"
    ]
}