{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Humanitarian Dataset Schema (CSV)",
    "type": "object",
    "properties": {
        "beneficiary_id": {
            "type": "string",
            "examples": [
                "B001",
                "B002",
                "B003"
            ]
        },
        "name": {
            "type": [
                "string",
                "null"
            ],
            "examples": [
                "John Banda",
                "Mary Phiri",
                "Peter Mwale"
            ]
        },
        "age": {
            "type": [
                "integer",
                "null"
            ],
            "minimum": 26.0,
            "maximum": 45.0,
            "examples": [
                34.0,
                28.0,
                45.0
            ]
        },
        "gender": {
            "type": "string",
            "examples": [
                "Male",
                "Female"
            ]
        },
        "country": {
            "type": "string",
            "examples": [
                "Zambia",
                "Malawi",
                "Zimbabwe"
            ]
        },
        "household_size": {
            "type": "integer",
            "minimum": 2.0,
            "maximum": 7.0,
            "examples": [
                5,
                4,
                7
            ]
        },
        "registration_date": {
            "type": "string",
            "format": "date",
            "examples": [
                "2026-01-10",
                "2026-01-11",
                "2026-01-12"
            ]
        }
    },
    "required": [
        "beneficiary_id",
        "gender",
        "country",
        "household_size",
        "registration_date"
    ]
}